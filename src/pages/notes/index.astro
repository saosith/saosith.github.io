---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => +b.data.date - +a.data.date);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Base
  title="Notes"
  description="Short technical notes: derivations, tool workflows, and debugging logs from analog IC design work."
>
  <div class="wrap section">
    <div class="section-head">
      <span class="idx">02</span>
      <h1 style="font-size:var(--t-xl)">Notes</h1>
      <p class="note">Derivations, tool workflows, and things that went wrong.</p>
    </div>

    {notes.length === 0 ? (
      <p class="empty-state">No notes published yet.</p>
    ) : (
      <ul class="note-list">
        {notes.map((n) => (
          <li class="note-item">
            <a href={`/notes/${n.id}/`}>
              <span class="note-date">{fmt(n.data.date)}</span>
              <span>
                <span class="note-title">{n.data.title}</span>
                <span class="note-sub" style="display:block">{n.data.summary}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</Base>
