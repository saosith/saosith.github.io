---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="That page does not exist on this site.">
  <div class="wrap section">
    <p class="mono small muted">404</p>
    <h1 style="margin-top:0.5rem">That page isn’t here</h1>
    <p class="muted" style="max-width:48ch;margin-top:0.8rem">
      The link may be out of date. The projects index lists everything published.
    </p>
    <div class="btn-row" style="margin-top:1.5rem">
      <a class="btn btn-primary" href="/#projects">Go to projects</a>
      <a class="btn" href="/">Home</a>
    </div>
  </div>
</Base>
