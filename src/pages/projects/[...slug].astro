---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DataBadge from '../../components/DataBadge.astro';
import SpecTable from '../../components/SpecTable.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { data } = project;
const { Content, headings } = await render(project);

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
---

<Base title={data.title} description={data.summary}>
  <div class="wrap project-header">
    <p class="small muted mono" style="margin-bottom:0.6rem">
      <a href="/#projects" style="color:inherit">Projects</a> / {data.tags[0] ?? 'design'}
    </p>
    <h1>{data.title}</h1>
    <p class="lede">{data.summary}</p>

    <div class="meta-row">
      {data.process && <span class="tag">{data.process}</span>}
      {data.tags.map((t) => <span class="tag">{t}</span>)}
      <span class="small muted" style="margin-left:auto">
        {fmt(data.date)}{data.updated && ` · updated ${fmt(data.updated)}`}
      </span>
    </div>
  </div>

  <div class="wrap project-layout" style="padding-bottom:2rem">
    <div>
      <DataBadge status={data.dataStatus} conditions={data.conditions} />

      {data.specs.length > 0 && (
        <div style="margin-top:1.8rem">
          <SpecTable
            rows={data.specs}
            conditions={data.conditions}
            footnotes={data.footnotes}
          />
        </div>
      )}

      <div class="prose" style="margin-top:2rem">
        <Content />
      </div>
    </div>

    <aside class="project-rail no-print" aria-label="Project summary">
      {data.headline.length > 0 && (
        <div class="rail-block">
          <h3>Key parameters</h3>
          <ul class="rail-list">
            {data.headline.map((h) => (
              <li>
                <span>{h.label}</span>
                <span class="v">{h.value}{h.unit && <span class="unit"> {h.unit}</span>}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      {toc.length > 0 && (
        <nav class="rail-block" aria-label="On this page">
          <h3>On this page</h3>
          <ul class="rail-toc">
            {toc.map((h) => (
              <li class={`lvl-${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ul>
        </nav>
      )}

      {data.tools.length > 0 && (
        <div class="rail-block">
          <h3>Tools</h3>
          <ul class="rail-list">
            {data.tools.map((t) => <li><span>{t}</span></li>)}
          </ul>
        </div>
      )}

      {data.links.length > 0 && (
        <div class="rail-block">
          <h3>Files</h3>
          <ul class="rail-toc">
            {data.links.map((l) => (
              <li><a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener">{l.label}</a></li>
            ))}
          </ul>
        </div>
      )}

      {data.ip && (
        <div class="rail-block">
          <h3>IP status</h3>
          <p class="small" style="padding:0.55rem 0.85rem 0.75rem;color:var(--ink-2)">{data.ip}</p>
        </div>
      )}
    </aside>
  </div>
</Base>
