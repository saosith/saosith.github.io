---
import { getCollection } from 'astro:content';

// REPORT_DRAFTS=1 (local draft builds only, never set by the deploy workflow)
// also lists drafts, marked as such, so they can be checked in context.
const withDrafts = process.env.REPORT_DRAFTS === '1';
const projects = (await getCollection('projects', ({ data }) => withDrafts || !data.draft))
  .sort((a, b) => a.data.order - b.data.order || +b.data.date - +a.data.date);

const tags = [...new Set(projects.flatMap((p) => p.data.tags))].sort();
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', timeZone: 'UTC' });
---

<section id="projects" class="wrap section rule-top">
  <div class="section-head">
    <h2>Projects</h2>
  </div>

  {projects.length === 0 ? (
    <div class="panel panel-pad" style="max-width:60ch">
      <h3>No projects published yet</h3>
      <p class="muted">
        The repository ships worked examples, kept as drafts so the page
        structure stays visible. Open one in the CMS, replace the numbers and
        the write-up with your own, then untick <span class="mono">Draft</span>
        to publish it.
      </p>
      <div class="btn-row" style="margin-top:var(--unit)">
        <a class="btn btn-primary" href="https://app.pagescms.org" target="_blank" rel="noopener">Open the CMS</a>
      </div>
    </div>
  ) : (
  <ul class="project-bands" data-list>
    {projects.map((p, i) => (
      <li
        class={`band band-${i % 2 === 0 ? 'light' : 'dark'}`}
        data-item
        data-tags={p.data.tags.join('|')}
        data-text={`${p.data.title} ${p.data.summary} ${p.data.tags.join(' ')} ${p.data.tools.join(' ')}`.toLowerCase()}
      >
        <div class="wrap band-inner">
          <a class="band-media" href={`/projects/${p.id}/`} tabindex="-1" aria-hidden="true">
            {p.data.coverVideo
              ? <video src={p.data.coverVideo} poster={p.data.cover} autoplay muted loop playsinline preload="metadata"></video>
              : p.data.cover
                ? <img src={p.data.cover} alt="" loading="lazy" decoding="async" />
                : <span class="band-media-empty">{p.data.title}</span>}
          </a>
          <div class="band-text">
            <p class="band-kicker">
              {p.data.tools[0] ?? p.data.tags[0]}<span aria-hidden="true"> · </span>{fmt(p.data.date)}
              {p.data.draft && <span class="chip chip-warning" style="margin-left:0.6rem">draft, local only</span>}
            </p>
            <h3 class="band-title">{p.data.title}</h3>
            <p class="band-sub">{p.data.summary}</p>
            {p.data.headline.length > 0 && (
              <dl class="band-figures">
                {p.data.headline.slice(0, 3).map((h) => (
                  <div><dt>{h.label}</dt><dd>{h.value}{h.unit ? ` ${h.unit}` : ''}</dd></div>
                ))}
              </dl>
            )}
            <a class="band-btn" href={`/projects/${p.id}/`}>Read more<span class="visually-hidden"> about {p.data.title}</span></a>
          </div>
        </div>
      </li>
    ))}
  </ul>
  )}

  <p class="empty-state" data-empty hidden>
    No project matches that filter. <button class="btn" type="button" data-clear-2>Show all projects</button>
  </p>
</section>

<script>
  const bar = document.querySelector<HTMLElement>('[data-filter]');
  if (bar) {
    const q = bar.querySelector<HTMLInputElement>('[data-q]')!;
    const chips = [...bar.querySelectorAll<HTMLButtonElement>('[data-tag]')];
    const clear = bar.querySelector<HTMLButtonElement>('[data-clear]')!;
    const count = bar.querySelector<HTMLElement>('[data-count]')!;
    const items = [...document.querySelectorAll<HTMLElement>('[data-item]')];
    const empty = document.querySelector<HTMLElement>('[data-empty]');
    const active = new Set<string>();

    function apply() {
      const term = q.value.trim().toLowerCase();
      let shown = 0;
      for (const it of items) {
        const tags = (it.dataset.tags || '').split('|');
        const okTag = active.size === 0 || [...active].every((t) => tags.includes(t));
        const okText = !term || (it.dataset.text || '').includes(term);
        const show = okTag && okText;
        it.hidden = !show;
        if (show) shown++;
      }
      count.textContent = `${shown} of ${items.length}`;
      if (empty) empty.hidden = shown !== 0;
      clear.hidden = active.size === 0 && !term;
      // Keep the filter in the URL, but never clobber the #section anchor.
      const params = new URLSearchParams();
      if (term) params.set('q', term);
      if (active.size) params.set('tag', [...active].join(','));
      const qs = params.toString();
      history.replaceState(null, '', (qs ? `?${qs}` : location.pathname) + '#projects');
    }

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        const t = chip.dataset.tag!;
        if (active.has(t)) active.delete(t); else active.add(t);
        chip.setAttribute('aria-pressed', String(active.has(t)));
        apply();
      });
    }
    q.addEventListener('input', apply);
    const reset = () => {
      active.clear();
      q.value = '';
      for (const c of chips) c.setAttribute('aria-pressed', 'false');
      apply();
    };
    clear.addEventListener('click', reset);
    document.querySelector('[data-clear-2]')?.addEventListener('click', reset);

    const url = new URLSearchParams(location.search);
    if (url.get('q')) q.value = url.get('q')!;
    for (const t of (url.get('tag') || '').split(',').filter(Boolean)) {
      active.add(t);
      chips.find((c) => c.dataset.tag === t)?.setAttribute('aria-pressed', 'true');
    }
    if (url.get('q') || url.get('tag')) apply();
  }
</script>
