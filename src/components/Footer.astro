---
import { SITE } from '../lib/site';
/**
 * One slim copyright line (copper redesign, 2026-11-10). No contact links here:
 * the Contact section has them, and the menu's Contact link reaches it from any page.
 */
const year = new Date().getFullYear();
---

<footer class="site-footer no-print">
  <div class="wrap site-footer-line">
    <p>© {year} {SITE.name}{SITE.footerNote && <span class="site-footer-note"> · {SITE.footerNote.replace(/\.$/, '')}</span>}</p>
  </div>
</footer>
