---
import { SITE } from '../lib/site';
const year = new Date().getFullYear();
---

<footer class="site-footer no-print">
  <div class="wrap site-footer-grid">
    <div>
      <h3>Contact</h3>
      <ul>
        <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li><a href={SITE.linkedin} rel="me noopener" target="_blank">LinkedIn</a></li>
        <li><a href={SITE.github} rel="me noopener" target="_blank">GitHub</a></li>
      </ul>
    </div>
    <div>
      <h3>Site</h3>
      <ul>
        <li><a href="/projects/">Projects</a></li>
        <li><a href="/notes/">Notes</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href={SITE.resume}>Résumé (PDF)</a></li>
      </ul>
    </div>
    <div>
      <h3>Data</h3>
      <ul>
        <li><a href="/data/opamp-ac.json">opamp-ac.json</a></li>
        <li><a href="/data/opamp-mc.json">opamp-mc.json</a></li>
        <li><a href="/data/bandgap-tc.json">bandgap-tc.json</a></li>
      </ul>
    </div>
    <div>
      <h3>Use</h3>
      <p style="max-width:34ch">
        Every design here targets the SkyWater sky130 open PDK. Nothing on this
        site is covered by a foundry NDA.
      </p>
      <p style="margin-top:0.6rem">© {year} {SITE.name}</p>
    </div>
  </div>
</footer>
