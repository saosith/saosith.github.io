---
import { loadData, eng } from '../lib/loadData';
import type { BodeData } from '../lib/charts';

const data = loadData<BodeData>('opamp-ac.json');
const tt = data.metrics.TT;
---

<div class="hero-plot-frame">
  <div class="hero-plot-head">
    <h2>Two-stage op-amp, open-loop gain across process corners</h2>
    <span class="cond">{data.meta.conditions}</span>
  </div>

  <div data-hero-bode>
    <noscript>
      <p class="small muted" style="padding:1rem 0">
        Open-loop gain {tt.dcGainDb} dB, unity-gain crossover {eng(tt.gbwHz ?? 0, 'Hz')},
        phase margin {tt.phaseMarginDeg}° at the typical corner.
      </p>
    </noscript>
  </div>

  <p class="small muted" style="margin-top:0.5rem">
    Hover for a readout at any frequency.
    <a href="/projects/two-stage-opamp/">Full write-up, corners and Monte Carlo →</a>
  </p>
</div>

<script>
  import { mountBode, type BodeData } from '../lib/charts';

  const el = document.querySelector<HTMLElement>('[data-hero-bode]');
  if (el) {
    fetch('/data/opamp-ac.json')
      .then((r) => r.json())
      .then((d: BodeData) => mountBode(el, d, { reference: 'TT', animate: true, compact: true }))
      .catch(() => {});
  }
</script>
