---
import { experience } from '../lib/about';
import { livePredicate } from '../lib/published';
import TimelineList from './TimelineList.astro';

const isLive = await livePredicate();
---

<section id="experience" class="wrap section rule-top">
  <div class="section-head">
    <span class="idx">02</span>
    <h2>Experience</h2>
    <p class="note">Each entry names a date and something you can open.</p>
  </div>

  <TimelineList entries={experience()} isLive={isLive} emptyText="Nothing listed yet." />
</section>
