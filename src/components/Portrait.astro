---
import { SITE } from '../lib/site';

/**
 * Hero image. Falls back to an explicit placeholder rather than a generic
 * avatar, so an empty slot reads as "not filled in yet".
 *
 * Upload in Pages CMS -> Site details -> Photo, and write the line underneath
 * in Photo caption.
 */
const photo = SITE.photo?.trim();
const caption = SITE.photoCaption?.trim();
---

<figure class="portrait">
  {photo ? (
    <img
      class="portrait-img"
      src={photo}
      alt={caption || `${SITE.name}, ${SITE.role}`}
      width="960"
      height="640"
      loading="eager"
      decoding="async"
    />
  ) : (
    <div class="portrait-empty">
      <svg viewBox="0 0 48 36" fill="none" aria-hidden="true">
        <rect x="1.5" y="1.5" width="45" height="33" rx="3" stroke="currentColor" stroke-width="2" />
        <circle cx="16" cy="13" r="4" stroke="currentColor" stroke-width="2" />
        <path d="M4 30l11-10 8 7 7-6 14 12" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
      </svg>
      <p>
        Add a photo in the CMS under <span class="mono">Site details → Photo</span>.
        A lab shot, a conference photo, or a headshot all work.
      </p>
    </div>
  )}

  <figcaption class={caption ? '' : 'is-placeholder'}>
    {caption || 'Add a caption in Site details → Photo caption. Say what it shows, where, and when.'}
  </figcaption>
</figure>
