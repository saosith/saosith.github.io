---
import { COURSES } from '../lib/about';
---

<section id="courses" class="wrap section rule-top">
  <div class="section-head">
    <span class="idx">04</span>
    <h2>Courses</h2>
    <p class="note">Coursework behind the work above.</p>
  </div>

  {COURSES.length === 0 ? (
    <p class="muted">Nothing listed yet.</p>
  ) : (
    <ul class="course-list">
      {COURSES.map((c) => (
        <li class="course-item">
          <div class="course-main">
            {c.code && <span class="course-code">{c.code}</span>}
            <span class="course-title">{c.title}</span>
          </div>
          {c.term && <div class="course-term">{c.term}</div>}
          {c.note && <p class="course-note">{c.note}</p>}
        </li>
      ))}
    </ul>
  )}
</section>
