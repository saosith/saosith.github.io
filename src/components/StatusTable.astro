---
interface Stage {
  stage: string;
  status?: 'done' | 'next' | 'planned';
  plan?: string;
}
interface Props {
  rows: Stage[];
}
const { rows = [] } = Astro.props;

/**
 * Project status as a copper trace through one via per stage (copper redesign,
 * 2026-11-10): filled via = complete, ringed = in progress, hollow = planned.
 * Each step also carries a word, so status never depends on colour alone.
 * The trace is copper up to the last finished stage.
 */
const LABEL = { done: 'Complete', next: 'In progress', planned: 'Planned' } as const;
const lastDone = rows.reduce((n, r, i) => (r.status === 'done' ? i : n), -1);
const pct = rows.length > 1 && lastDone >= 0 ? (lastDone / (rows.length - 1)) * 100 : 0;
---

{rows.length > 0 ? (
  <ol class="cu-status" style={`--n:${rows.length};--done:${pct}%`}>
    {rows.map((r) => {
      const s = r.status ?? 'planned';
      return (
        <li class={`cu-step is-${s}`}>
          <i aria-hidden="true"></i>
          <span class="cu-step-name">{r.stage}</span>
          <span class="cu-step-state">{LABEL[s] ?? LABEL.planned}</span>
          {r.plan && <span class="cu-step-plan">{r.plan}</span>}
        </li>
      );
    })}
  </ol>
) : (
  <p class="report-empty">No stages recorded yet. Add them under "Project status" in the CMS.</p>
)}
