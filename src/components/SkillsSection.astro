---
import { skillGroups } from '../lib/about';

const SKILLS = skillGroups();
---

<section id="skills" class="wrap section rule-top">
  <div class="section-head">
    <h2>Skills</h2>
  </div>

  <div class="skills">
    {SKILLS.map((g) => (
      <div class="skill-group">
        <h3>{g.name}</h3>
        <ul>
          {g.items.map((i) => <li>{i.skill}</li>)}
        </ul>
      </div>
    ))}
  </div>
</section>
