---
import { loadData, eng } from '../lib/loadData';
import type { BodeData } from '../lib/charts';

interface Props {
  figNo: string;
  caption: string;
  file?: string;
  reference?: string;
}

const { figNo, caption, file = 'opamp-ac.json', reference = 'TT' } = Astro.props;
const data = loadData<BodeData>(file);
const names = Object.keys(data.corners);

// Worst-case row: the corner a reviewer actually cares about.
const worstPm = names.reduce((a, b) =>
  (data.metrics[a].phaseMarginDeg ?? 999) < (data.metrics[b].phaseMarginDeg ?? 999) ? a : b);
const id = `bode-${figNo.replace(/\W/g, '')}`;
---

<figure class="figure chart-figure">
  <div class="chart-frame">
    <div class="chart-head">
      <h3>{data.meta.title}</h3>
      <span class="cond">{data.meta.conditions}</span>
    </div>

    <div id={id} data-bode data-file={`/data/${file}`} data-reference={reference}>
      <noscript>
        <p class="small muted">
          The interactive plot needs JavaScript. The corner summary below carries the same numbers.
        </p>
      </noscript>
    </div>

    <div class="scroll-x" style="margin-top:var(--unit);border-top:1px solid var(--rule-strong)">
    <table class="spec-table">
      <caption class="visually-hidden">Corner summary</caption>
      <thead>
        <tr>
          <th scope="col">Corner</th>
          <th scope="col">DC gain</th>
          <th scope="col">Unity-gain freq.</th>
          <th scope="col">Phase margin</th>
        </tr>
      </thead>
      <tbody>
        {names.map((n) => (
          <tr>
            <th scope="row" class="sym" style="color:var(--ink)">
              {n}{n === reference && <span class="muted"> (ref)</span>}
              {n === worstPm && n !== reference && <span class="muted"> (worst PM)</span>}
            </th>
            <td class="v">{data.metrics[n].dcGainDb.toFixed(1)} <span class="unit">dB</span></td>
            <td class="v">{data.metrics[n].gbwHz ? eng(data.metrics[n].gbwHz!, 'Hz') : '—'}</td>
            <td class="v">{data.metrics[n].phaseMarginDeg?.toFixed(1) ?? '—'} <span class="unit">°</span></td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>

    <details class="data-table">
      <summary>Show the plotted points</summary>
      <div class="scroll-x">
        <table>
          <thead>
            <tr>
              <th>Frequency</th>
              {names.map((n) => <th>{n} gain / phase</th>)}
            </tr>
          </thead>
          <tbody>
            {data.freq_hz.map((f, i) => i % 12 === 0 && (
              <tr>
                <td>{eng(f, 'Hz')}</td>
                {names.map((n) => (
                  <td>{data.corners[n].gain_db[i].toFixed(1)} dB / {data.corners[n].phase_deg[i].toFixed(0)}°</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="small muted">
        Every 12th sample. <a href={`/data/${file}`}>Download the full dataset</a>.
      </p>
    </details>
  </div>

  <figcaption>
    <span class="fig-no">{figNo}</span>
    <span>{caption}</span>
  </figcaption>
</figure>

<script>
  import { mountBode, type BodeData } from '../lib/charts';

  for (const el of document.querySelectorAll<HTMLElement>('[data-bode]')) {
    const file = el.dataset.file!;
    fetch(file)
      .then((r) => r.json())
      .then((data: BodeData) => {
        mountBode(el, data, {
          reference: el.dataset.reference,
          animate: el.hasAttribute('data-animate'),
          compact: el.hasAttribute('data-compact'),
        });
      })
      .catch(() => {
        el.innerHTML =
          '<p class="small muted">Could not load ' + file + '. The corner summary below still applies.</p>';
      });
  }
</script>
