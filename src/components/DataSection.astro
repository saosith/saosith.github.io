---
import { readdirSync, statSync, readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

/**
 * Lists the datasets in public/data, reading each file's own `meta` block so
 * titles and conditions are never retyped.
 *
 * Files marked `"source": "model"` are the placeholder datasets that ship with
 * the repo — analytical output, not simulation or silicon — so they are left
 * out. Convert real ngspice results with scripts/raw-to-json.mjs (which writes
 * `"source": "simulated"`) and they appear here on the next build.
 */
const dir = fileURLToPath(new URL('../../public/data', import.meta.url));

type Dataset = { file: string; size: number; title: string; conditions: string; source: string };
let all: Dataset[] = [];

try {
  all = readdirSync(dir)
    .filter((f) => f.endsWith('.json'))
    .sort()
    .map((f) => {
      const meta = (() => {
        try { return JSON.parse(readFileSync(`${dir}/${f}`, 'utf8')).meta ?? {}; }
        catch { return {}; }
      })();
      return {
        file: f,
        size: statSync(`${dir}/${f}`).size,
        title: meta.title ?? f,
        conditions: meta.conditions ?? '',
        source: meta.source ?? '',
      };
    });
} catch { all = []; }

const files = all.filter((f) => f.source !== 'model');

const kb = (n: number) => `${(n / 1024).toFixed(0)} kB`;
const SOURCE_LABEL: Record<string, string> = { simulated: 'simulated', measured: 'measured' };
---

<section id="data" class="wrap section rule-top">
  <div class="section-head">
    <h2>Data</h2>
  </div>

  {files.length === 0 ? (
    <div class="panel panel-pad" style="max-width:62ch">
      <h3>No datasets published yet</h3>
      <p class="muted">
        Once a project has real simulation or measurement results, the file
        behind every plot is listed here as a direct download, with the
        conditions it was taken under.
      </p>
      <p class="muted">
        Convert an ngspice run with
        <span class="mono">scripts/raw-to-json.mjs</span> and it appears on the
        next build. Nothing to configure.
      </p>
    </div>
  ) : (
    <>
      <div class="scroll-x">
        <table class="spec-table">
          <caption>Downloadable datasets</caption>
          <thead>
            <tr>
              <th scope="col">Dataset</th>
              <th scope="col">Source</th>
              <th scope="col">Size</th>
              <th scope="col">File</th>
            </tr>
          </thead>
          <tbody>
            {files.map((f) => (
              <tr>
                <th scope="row">
                  {f.title}
                  {f.conditions && <span class="data-cond">{f.conditions}</span>}
                </th>
                <td class="sym">{SOURCE_LABEL[f.source] ?? '—'}</td>
                <td class="v">{kb(f.size)}</td>
                <td><a class="data-dl" href={`/data/${f.file}`} download>{f.file}</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="small muted" style="margin-top:var(--unit)">
        Plain JSON. Each file carries a <span class="mono">meta</span> block naming
        the conditions it was taken under, so a number is never separated from the
        setup that produced it.
      </p>
    </>
  )}
</section>
