---
import type { TimelineEntry } from '../lib/about';

interface Props {
  entries: TimelineEntry[];
  /** Hrefs that actually resolve, so dead links degrade instead of 404ing. */
  isLive: (href?: string) => boolean;
  emptyText: string;
  /** Show the right-hand media/highlights column (wide screens only). */
  withSide?: boolean;
}
const { entries, isLive, emptyText, withSide = false } = Astro.props;

/**
 * Monogram used when an entry has no logo yet. Takes the first letter of up to
 * three words, skipping the small connecting words that would otherwise crowd
 * the tile, so "Student Learning Center" reads SLC rather than SLC-of-the.
 */
const SKIP = new Set(['of', 'the', 'and', 'for', 'at', 'in', 'a']);
function monogram(entry: TimelineEntry): string {
  const source = entry.org?.trim() || entry.title;
  return source
    .split(/[\s—–-]+/)
    .filter((w) => /[a-z0-9]/i.test(w) && !SKIP.has(w.toLowerCase()))
    .slice(0, 3)
    .map((w) => w[0].toUpperCase())
    .join('');
}
---

{entries.length === 0 ? (
  <p class="muted">{emptyText}</p>
) : (
  <ol class={`timeline${withSide ? ' timeline-side' : ''}`}>
    {entries.map((t) => (
      <li class="tl-item">
        <div class="tl-date">{t.date}</div>
        {t.logo
          ? <img class="tl-logo" src={t.logo} alt={t.org ? `${t.org} logo` : ''} width="80" height="80" loading="lazy" decoding="async" />
          : <div class="tl-logo tl-logo-empty" aria-hidden="true">{monogram(t)}</div>}
        <div>
          <div class="tl-title">
            {t.title}
            {t.placeholder && <span class="chip chip-warning" style="margin-left:0.5rem">replace this entry</span>}
          </div>
          {t.org && <div class="tl-org">{t.org}</div>}
          {t.body && <p class="tl-body">{t.body}</p>}
          {t.evidenceLabel && (
            <div class="tl-evidence">
              {isLive(t.evidenceHref)
                ? <a href={t.evidenceHref}>{t.evidenceLabel}</a>
                : <span class="muted">{t.evidenceLabel} — add the link</span>}
            </div>
          )}
        </div>
        {withSide && (
          <div class="tl-side">
            {t.media && (/\.(mp4|webm)$/i.test(t.media)
              ? <video class="tl-media" src={t.media} poster={t.media.replace(/\.(mp4|webm)$/i, '.jpg')}
                  autoplay muted loop playsinline preload="metadata" aria-label={t.mediaAlt ?? ''}></video>
              : <a class="tl-media" href={t.evidenceHref || t.media} target="_blank" rel="noopener">
                  <img src={t.media} alt={t.mediaAlt ?? ''} loading="lazy" decoding="async" />
                </a>)}
            {t.media && t.mediaAlt && <p class="tl-caption">{t.mediaAlt}</p>}
            {t.media2 && (
              <a class="tl-media tl-media-2" href={t.media2} target="_blank" rel="noopener">
                <img src={t.media2} alt={t.media2Alt ?? ''} loading="lazy" decoding="async" />
              </a>
            )}
            {t.media2 && t.media2Alt && <p class="tl-caption">{t.media2Alt}</p>}
            {(t.highlights ?? []).length > 0 && (
              <ul class="tl-highlights" aria-label="Highlights">
                {(t.highlights ?? []).map((h) => <li class="tag">{h}</li>)}
              </ul>
            )}
            {!t.media && !t.media2 && (t.highlights ?? []).length === 0 && (
              <div class="tl-side-empty">Add a photo or highlights in the CMS</div>
            )}
          </div>
        )}
      </li>
    ))}
  </ol>
)}
