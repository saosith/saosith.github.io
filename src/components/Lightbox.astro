---
/**
 * Click-to-enlarge for images and PDFs, anywhere on the site.
 *
 * Rather than tagging every link, this delegates on the document and picks up
 * any anchor pointing at an image or a PDF — figures, evidence links, the files
 * list in a project rail. Header and footer are excluded: the resume button
 * there reads as a download, and hijacking it would surprise people.
 *
 * Progressive enhancement. Without JavaScript every one of those links is still
 * an ordinary link to the file, which is what it was before this existed.
 */
---

<div class="lightbox" data-lb hidden>
  <div class="lb-backdrop" data-lb-close></div>

  <div class="lb-panel" role="dialog" aria-modal="true" aria-label="File viewer">
    <div class="lb-bar">
      <span class="lb-name" data-lb-name></span>
      <span class="lb-zoom" data-lb-zoomui>
        <button type="button" data-lb-out aria-label="Zoom out">&minus;</button>
        <output data-lb-pct>100%</output>
        <button type="button" data-lb-in aria-label="Zoom in">+</button>
        <button type="button" data-lb-reset>Fit</button>
      </span>
      <a class="lb-open" data-lb-open target="_blank" rel="noopener">Open in new tab</a>
      <button class="lb-close" type="button" data-lb-close aria-label="Close">&times;</button>
    </div>

    <div class="lb-stage" data-lb-stage>
      <img data-lb-img alt="" hidden />
      <iframe data-lb-frame title="PDF preview" hidden></iframe>
    </div>

    <p class="lb-hint" data-lb-hint>Scroll to zoom &middot; drag to pan &middot; Esc to close</p>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-lb]');
  if (root) {
    const panel = root.querySelector<HTMLElement>('.lb-panel')!;
    const stage = root.querySelector<HTMLElement>('[data-lb-stage]')!;
    const img = root.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const frame = root.querySelector<HTMLIFrameElement>('[data-lb-frame]')!;
    const nameEl = root.querySelector<HTMLElement>('[data-lb-name]')!;
    const pct = root.querySelector<HTMLOutputElement>('[data-lb-pct]')!;
    const zoomUI = root.querySelector<HTMLElement>('[data-lb-zoomui]')!;
    const hint = root.querySelector<HTMLElement>('[data-lb-hint]')!;
    const openLink = root.querySelector<HTMLAnchorElement>('[data-lb-open]')!;
    const closeBtn = root.querySelector<HTMLButtonElement>('.lb-close')!;

    const IMG = /\.(png|jpe?g|gif|webp|avif|svg)(\?|#|$)/i;
    const PDF = /\.pdf(\?|#|$)/i;
    const MIN = 1;
    const MAX = 8;

    let scale = 1;
    let tx = 0;
    let ty = 0;
    let last: HTMLElement | null = null;

    function draw() {
      img.style.transform = 'translate(' + tx + 'px,' + ty + 'px) scale(' + scale + ')';
      pct.value = Math.round(scale * 100) + '%';
      stage.classList.toggle('is-zoomed', scale > 1);
    }

    function zoomTo(next: number, ox = 0, oy = 0) {
      const clamped = Math.min(MAX, Math.max(MIN, next));
      const k = clamped / scale;
      // Keep the point under the cursor fixed while the image scales.
      tx = ox - (ox - tx) * k;
      ty = oy - (oy - ty) * k;
      scale = clamped;
      if (scale === 1) { tx = 0; ty = 0; }
      draw();
    }

    function reset() { scale = 1; tx = 0; ty = 0; draw(); }

    function openViewer(href: string, label: string, isPdf: boolean) {
      last = document.activeElement as HTMLElement;
      nameEl.textContent = label;
      openLink.href = href;

      img.hidden = isPdf;
      frame.hidden = !isPdf;
      zoomUI.hidden = isPdf;
      // The browser's own PDF viewer brings its own zoom, so ours would fight it.
      hint.textContent = isPdf
        ? 'Esc to close'
        : 'Scroll to zoom · drag to pan · Esc to close';

      if (isPdf) { frame.src = href; } else { img.src = href; reset(); }

      root.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      closeBtn.focus();
    }

    function close() {
      root.hidden = true;
      document.documentElement.style.overflow = '';
      img.removeAttribute('src');
      frame.removeAttribute('src');
      if (last) last.focus();
      last = null;
    }

    document.addEventListener('click', (e) => {
      const me = e as MouseEvent;
      // Leave deliberate new-tab gestures alone.
      if (me.button !== 0 || me.metaKey || me.ctrlKey || me.shiftKey || me.altKey) return;

      const target = e.target as HTMLElement | null;
      const a = target && target.closest
        ? (target.closest('a[href]') as HTMLAnchorElement | null)
        : null;
      if (!a || a.closest('[data-lb]')) return;
      if (a.closest('.site-header') || a.closest('.site-footer')) return;
      if (a.hasAttribute('download') || a.dataset.noLightbox !== undefined) return;

      const href = a.getAttribute('href') || '';
      const isPdf = PDF.test(href);
      if (!isPdf && !IMG.test(href)) return;

      e.preventDefault();
      const inner = a.querySelector('img');
      const label =
        (inner && inner.getAttribute('alt')) ||
        (a.textContent || '').trim() ||
        href.split('/').pop() ||
        '';
      openViewer(a.href, label, isPdf);
    });

    root.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('[data-lb-close]')) close();
    });

    document.addEventListener('keydown', (e) => {
      if (root.hidden) return;
      if (e.key === 'Escape') { close(); return; }

      if (e.key === 'Tab') {
        // Small trap: keep focus inside the panel.
        const items = [...panel.querySelectorAll<HTMLElement>('button, a[href]')]
          .filter((el) => el.offsetParent !== null);
        if (!items.length) return;
        const i = items.indexOf(document.activeElement as HTMLElement);
        const next = e.shiftKey ? i - 1 : i + 1;
        if (i === -1 || next < 0 || next >= items.length) {
          e.preventDefault();
          (e.shiftKey ? items[items.length - 1] : items[0]).focus();
        }
        return;
      }

      if (img.hidden) return;
      if (e.key === '+' || e.key === '=') zoomTo(scale * 1.4);
      if (e.key === '-') zoomTo(scale / 1.4);
      if (e.key === '0') reset();
    });

    root.querySelector('[data-lb-in]')!.addEventListener('click', () => zoomTo(scale * 1.4));
    root.querySelector('[data-lb-out]')!.addEventListener('click', () => zoomTo(scale / 1.4));
    root.querySelector('[data-lb-reset]')!.addEventListener('click', reset);

    stage.addEventListener('wheel', (e) => {
      if (img.hidden) return;
      e.preventDefault();
      const r = stage.getBoundingClientRect();
      zoomTo(
        scale * (e.deltaY < 0 ? 1.15 : 1 / 1.15),
        e.clientX - r.left - r.width / 2,
        e.clientY - r.top - r.height / 2,
      );
    }, { passive: false });

    stage.addEventListener('dblclick', () => {
      if (img.hidden) return;
      if (scale > 1) reset(); else zoomTo(2.5);
    });

    let dragging = false;
    let px = 0;
    let py = 0;
    stage.addEventListener('pointerdown', (e) => {
      if (img.hidden || scale === 1) return;
      dragging = true;
      px = e.clientX;
      py = e.clientY;
      stage.setPointerCapture(e.pointerId);
    });
    stage.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      tx += e.clientX - px;
      ty += e.clientY - py;
      px = e.clientX;
      py = e.clientY;
      draw();
    });
    const stop = (e: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      if (stage.hasPointerCapture(e.pointerId)) stage.releasePointerCapture(e.pointerId);
    };
    stage.addEventListener('pointerup', stop);
    stage.addEventListener('pointercancel', stop);
  }
</script>
