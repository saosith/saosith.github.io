---
import { SITE } from '../lib/site';

/** Quick links under the tagline. Anything left blank in the CMS is skipped. */
const items = [
  SITE.email && { href: `mailto:${SITE.email}`, label: SITE.email, icon: 'mail', ext: false },
  SITE.phone && { href: `tel:${SITE.phone.replace(/[^\d+]/g, '')}`, label: SITE.phone, icon: 'phone', ext: false },
  SITE.linkedin && { href: SITE.linkedin, label: 'LinkedIn', icon: 'linkedin', ext: true },
  SITE.github && { href: SITE.github, label: 'GitHub', icon: 'github', ext: true },
].filter(Boolean) as { href: string; label: string; icon: string; ext: boolean }[];
---

<ul class="hero-contacts">
  {items.map((i) => (
    <li>
      <a href={i.href} {...(i.ext ? { target: '_blank', rel: 'me noopener' } : {})}>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          {i.icon === 'mail' && (
            <>
              <rect x="2.5" y="4.5" width="19" height="15" rx="2" stroke="currentColor" stroke-width="1.7" />
              <path d="M3 6.5l9 6 9-6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
            </>
          )}
          {i.icon === 'phone' && (
            <path d="M6.5 3.5h3l1.5 4-2 1.5a12 12 0 006 6l1.5-2 4 1.5v3a2 2 0 01-2.2 2A17 17 0 014.5 5.7 2 2 0 016.5 3.5z"
                  stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
          )}
          {i.icon === 'linkedin' && (
            <>
              <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.7" />
              <path d="M7 10.5V17M7 7.5v.01M11 17v-3.6c0-1.2.8-2.1 2-2.1s2 .9 2 2.1V17"
                    stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
            </>
          )}
          {i.icon === 'github' && (
            <path d="M9 19c-4 1.2-4-2.2-5.5-2.8M15 21v-3.3c0-.9.1-1.3-.4-1.8 2.3-.3 4.4-1.2 4.4-5a3.9 3.9 0 00-1-2.7 3.6 3.6 0 00-.1-2.7s-.9-.3-2.9 1.1a10 10 0 00-5 0C7.9 4.4 7 4.7 7 4.7a3.6 3.6 0 00-.1 2.7 3.9 3.9 0 00-1 2.7c0 3.8 2.1 4.7 4.4 5-.4.4-.4.9-.4 1.5V21"
                  stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
          )}
        </svg>
        <span>{i.label}</span>
      </a>
    </li>
  ))}
</ul>
