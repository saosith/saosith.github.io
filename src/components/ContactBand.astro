---
import { SITE } from '../lib/site';
import Traces from './Traces.astro';

/**
 * Closing call to action (copper redesign, 2026-11-10): the ask on the left,
 * direct links on the right. There is no message box: the site has no backend,
 * so a box could never actually send anything. Text comes from site.json
 * (ctaKicker / ctaTitle / ctaSub), editable in Pages CMS.
 */
const site = SITE as typeof SITE & { ctaKicker?: string; ctaTitle?: string; ctaSub?: string };
const kicker = site.ctaKicker?.trim() || 'Open to work';
const title = site.ctaTitle?.trim() || 'Looking for a 2027 hardware engineering internship.';
const sub = site.ctaSub?.trim() || '';
const host = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
// Simple line icons (24 px grid), drawn in currentColor.
const ICON = {
  linkedin: 'M4 4h16v16H4zM8 10v6M8 7.5v.01M12 16v-6M12 12.5c0-1.5 1-2.5 2.3-2.5S16 11 16 12.5V16',
  email: 'M3 6h18v12H3zM3 7l9 6 9-6',
  github: 'M9 8l-4 4 4 4M15 8l4 4-4 4',
  resume: 'M6 3h9l4 4v14H6zM15 3v4h4M9 12h7M9 16h7',
};
const links = [
  SITE.linkedin && { icon: ICON.linkedin, label: 'LinkedIn', detail: 'Message me', href: SITE.linkedin, primary: true },
  SITE.email && { icon: ICON.email, label: 'Email', detail: SITE.email, href: `mailto:${SITE.email}?subject=${encodeURIComponent('From your website')}` },
  SITE.github && { icon: ICON.github, label: 'GitHub', detail: host(SITE.github), href: SITE.github },
  SITE.resume && { icon: ICON.resume, label: SITE.resumeLabel, detail: 'PDF', href: SITE.resume },
].filter(Boolean) as { icon: string; label: string; detail: string; href: string; primary?: boolean }[];
---

<section id="contact" class="cta-band no-print" aria-labelledby="cta-title">
  <Traces variant="contact" />
  <div class="wrap cta-inner">
    <div>
      <p class="cta-kicker">{kicker}</p>
      <h2 id="cta-title" class="cta-title">{title}</h2>
      {sub && <p class="cta-sub">{sub}</p>}
    </div>

    <ul class="cta-links">
      {links.map((l) => (
        <li>
          <a class={`cta-link${l.primary ? ' is-primary' : ''}`} href={l.href}
             target={l.href.startsWith('http') ? '_blank' : undefined} rel={l.href.startsWith('http') ? 'noopener' : undefined}>
            <span class="cta-link-main">
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d={l.icon} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
              {l.label}
            </span>
            <small>{l.detail}</small>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
